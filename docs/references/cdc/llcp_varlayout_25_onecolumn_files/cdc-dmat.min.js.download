                    <button data-option="2" data-value="3" aria-label="`+h.answer6+`" class="border-0"><span class="cdc-fa-star cdc-fa-light"></span></button>
                    <button data-option="2" data-value="4" aria-label="`+h.answer7+`" class="border-0"><span class="cdc-fa-star cdc-fa-light"></span></button>
